# Copy to /etc/obex-frpc/config.env (root-owned, chmod 600 — contains a
# bearer credential) and fill in every value. Loaded by both systemd units
# via EnvironmentFile=.

# Base URL of the Obex backend API (no trailing slash).
OBEX_BACKEND_URL=https://api.example.com

# Bearer token this device authenticates with. PLACEHOLDER: the backend does
# not yet have a device/service-account auth mechanism — GET
# /cameras/:id/tunnel-config currently only accepts a logged-in user's own
# access token and checks camera ownership. Confirm the real device-auth
# story with the backend team before deploying this beyond a dev box. See
# README.md "Open questions for the backend team".
OBEX_DEVICE_TOKEN=replace-me

# Comma-separated camera IDs this Pi is responsible for tunneling. There is
# currently no "list cameras for this device" backend endpoint, so this is
# maintained manually per device for now.
OBEX_CAMERA_IDS=replace-with-camera-id-1,replace-with-camera-id-2

# Rarely need to change these:
OBEX_FRPC_CONFIG_PATH=/etc/obex-frpc/frpc.toml
OBEX_FRPC_BIN=/usr/local/bin/frpc
OBEX_FRPC_ADMIN_PORT=7400
